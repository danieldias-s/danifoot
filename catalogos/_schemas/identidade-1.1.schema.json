{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Elifoot identidade compartilhada 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogClubId",
    "name",
    "shortName",
    "abbreviation",
    "colors"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.1"
    },
    "catalogClubId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": ".*\\S.*"
    },
    "shortName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "abbreviation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "crestFile": {
      "anyOf": [
        {
          "type": "string",
          "description": "PNG/JPEG relativo a pasta do ano, sem .. ou links."
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
